{
  "name": "nepali-date-system",
  "version": "1.0.1",
  "description": "Nepali date converter for JavaScript and TypeScript: BS to AD, AD to BS, Bikram Sambat calendar, Nepal fiscal years and age",
  "keywords": [
    "nepali date",
    "nepali-date",
    "nepali date converter",
    "nepali-date-converter",
    "bs to ad",
    "ad to bs",
    "bikram sambat",
    "bikram-sambat",
    "nepali calendar",
    "nepali fiscal year",
    "nepali age calculator",
    "nepali",
    "nepal",
    "patro",
    "miti"
  ],
  "homepage": "https://github.com/saurabbikramsen/nepali-date-system#readme",
  "bugs": {
    "url": "https://github.com/saurabbikramsen/nepali-date-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saurabbikramsen/nepali-date-system.git"
  },
  "author": "Saurab Bikram Sen",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "npm run build && vitest bench --run --reporter=verbose",
    "smoke": "node scripts/smoke.mjs",
    "size": "npm run build && size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "nepali-date-converter": "3.4.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.1.0"
  }
}
