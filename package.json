{
  "name": "nepali-date-system",
  "version": "1.0.0",
  "description": "Nepali date converter and Bikram Sambat calendar for JavaScript and TypeScript: BS to AD and AD to BS, today's date in Nepal on any server, database query ranges, Nepal fiscal years and quarters, age and date differences, and formatting in English or Nepali (Devanagari)",
  "keywords": [
    "nepali",
    "nepali-date",
    "nepali-date-converter",
    "bikram-sambat",
    "bs-to-ad",
    "ad-to-bs",
    "nepali-calendar",
    "nepal",
    "calendar",
    "date",
    "date-converter",
    "patro",
    "miti",
    "devanagari",
    "kathmandu",
    "timezone",
    "typescript",
    "fiscal-year",
    "nepal-fiscal-year",
    "age"
  ],
  "homepage": "https://github.com/saurabbikramsen/nepali-date-system#readme",
  "bugs": {
    "url": "https://github.com/saurabbikramsen/nepali-date-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saurabbikramsen/nepali-date-system.git"
  },
  "author": "Saurab Bikram Sen",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "nepali-date-converter": "3.4.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3"
  }
}
